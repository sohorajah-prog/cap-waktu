# Salin jadi .env lalu sesuaikan. Semuanya opsional — aplikasi tetap jalan
# dengan nilai bawaan.

# Tempat basis data dan berkas gambar disimpan.
# Di Coolify, arahkan ke volume persisten. Nilai ini sudah disetel di Dockerfile.
CAP_WAKTU_DATA_DIR=/app/data

# Identitas yang dikirim ke Nominatim saat mencari wilayah dari koordinat.
# Kebijakan pemakaian mereka mewajibkan kontak yang bisa dihubungi — ganti
# dengan email atau URL Anda sebelum dipakai banyak orang.
CAP_WAKTU_GEOCODER_UA=CapWaktu/1.0 (https://contoh.id; admin@contoh.id)
